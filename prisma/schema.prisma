generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
}

model Facility {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?  // Name of the lucide-react icon (e.g. "Wifi")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model College {
  id                  String     @id @default(uuid())
  name                String
  slug                String     @unique
  city                String
  state               String
  logoUrl             String
  
  // High-Level Display
  priorityScore       Int        @default(0)
  rating              Float      @default(0.0)
  ownershipType       String?    // e.g. "Private", "Public", "Government"
  status              CollegeStatus @default(PUBLISHED)
  offerText           String?    // e.g. "20% Off", "Hot Deal", "Special Offer"
  
  // SEO Metadata (Dedicated for Search Engines)
  seoTitle            String?
  seoDescription      String?    @db.Text
  seoKeywords         String?    @db.Text
  
  // 1:1 Encapsulated Relations
  info                CollegeInfo?
  placement           Placement?

  // 1:Many Encapsulated Relations
  courses             Course[]
  galleries           GalleryImage[]
  rankings            Ranking[]
  enquiries           Enquiry[]
  accreditations      Accreditation[]
  deadlines           Deadline[]
  faqs                Faq[]

  // Affiliation Details
  universityId        String?
  university          University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  collegeType         String?     // e.g. "Affiliated", "Autonomous"

  // Amenities built-in array for quick filtering
  facilities          String[]
  hostelAvailable     Boolean    @default(false)
  
  overallBrochureUrl  String?    // Link to main institutional prospectus
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

enum CollegeStatus {
  DRAFT
  PUBLISHED
}

model CollegeInfo {
  id              String   @id @default(uuid())
  collegeId       String   @unique
  college         College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  aboutHtml       String?  @db.Text
  highlightsHtml  String?  @db.Text
  admissionsHtml  String?  @db.Text
  scholarshipHtml String?  @db.Text
}

model Placement {
  id              String      @id @default(uuid())
  collegeId       String      @unique
  college         College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  highestPackage   Float?
  averagePackage   Float?
  placementPercent Float?
  recruiters       Recruiter[]
}

model Recruiter {
  id          String    @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  
  name        String
  logoUrl     String?   // URL or path to company logo image
  website     String?   // Link to company website
  
  createdAt   DateTime  @default(now())
}

model Course {
  id              String   @id @default(uuid())
  collegeId       String
  college         College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  degreeId        String?  // Made optional momentarily to preserve existing ghost-row DB data
  degree          Degree?  @relation(fields: [degreeId], references: [id], onDelete: SetNull)
  
  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  
  name            String
  duration        String?
  eligibility     String?  @db.Text
  originalFee     Int
  discountedFee   Int
  
  brochureUrl     String?  // PDF or Image File upload link
  feeStructureUrl String?  // PDF or Image File upload link
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryImage {
  id         String   @id @default(uuid())
  collegeId  String
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  imageUrl   String
  caption    String?
}

model Ranking {
  id         String   @id @default(uuid())
  collegeId  String
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  agency     String   // e.g. "NIRF"
  rank       Int
  year       Int
}

model GlobalSetting {
  id             String   @id @default("GLOBAL")
  banners        String[] // Deprecated: moving to Banner model
  contactEmail   String?
  contactPhone   String?
  officeHours    String?
  officeAddress  String?  @db.Text
  emailTemplates String?  @db.Text
  
  // Footer & Branding Details
  logoUrl        String?
  footerAbout    String?  @db.Text
  copyrightText  String?
  socialLinks    String?  @db.Text // JSON stringified array of links
  availableFacilities String[] 
  
  updatedAt      DateTime @updatedAt
}

model Lead {
  phone              String    @id
  studentName        String
  email              String?
  highSchoolPercent  Float
  interestedStream   String
  enquiries          Enquiry[]
  chatMessages       ChatMessage[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ChatMessage {
  id        String   @id @default(uuid())
  leadPhone String
  lead      Lead     @relation(fields: [leadPhone], references: [phone], onDelete: Cascade)
  sender    Sender   @default(LEAD)
  content   String   @db.Text
  createdAt DateTime @default(now())
}

enum Sender {
  LEAD
  ADMIN
}

model Enquiry {
  id        String   @id @default(uuid())
  leadPhone String
  lead      Lead     @relation(fields: [leadPhone], references: [phone], onDelete: Cascade)
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Status {
  PENDING
  CALLED
  INTERESTED
  ADMITTED
}

model Degree {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "B.Tech"
  slug      String   @unique // e.g. "b-tech"
  sortOrder Int      @default(0) // Controls display order on the User Portal carousel
  courses   Course[]
  specializations Specialization[]
  newsArticles    NewsArticle[] // Opposite relation for News
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specialization {
  id        String   @id @default(uuid())
  degreeId  String
  degree    Degree   @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Computer Science", "Mechanical"
  slug      String   @unique // e.g. "computer-science"
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique // Full Name: "Rajasthan Technical University"
  shortName String?  // "RTU"
  slug      String   @unique
  colleges  College[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Accreditation {
  id        String   @id @default(uuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  label     String   // "NAAC", "NBA", "REAP Code"
  value     String   // "A++", "Accredited", "007"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deadline {
  id        String   @id @default(uuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  event     String   // "Application Start", "Counseling Date"
  date      DateTime
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  question  String   @db.Text
  answer    String   @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  imageUrl    String
  title       String?
  subTitle    String?  @db.Text
  linkUrl     String?  // The URL CTA redirects to
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String?  @unique // SEO Friendly URL slug (Optional for old data)
  excerpt     String?  @db.Text  // Short summary shown on homepage
  content     String?  @db.Text  // Full rich text content
  imageUrl    String?             // Cover image URL
  category    String   @default("General")
  linkUrl     String?             // Optional external or internal link
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())

  // Connects news to a specific degree/stream for related colleges recommendations
  degreeId    String?
  degree      Degree?  @relation(fields: [degreeId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaticPage {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String?  @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
